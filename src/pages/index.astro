---
import Header from '../components/Header.astro';
import ToolCard from '../components/ToolCard.astro';
import AdSenseCard from '../components/AdSenseCard.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import toolsData from '../data/tools.json';
import '../styles/global.css';

const activeTools = toolsData.filter((tool) => tool.is_active === true);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Directorio de Herramientas IA</title>
    <meta name="description" content="Explora la colección más completa de herramientas de Inteligencia Artificial. Aprende, crea y simplifica tus tareas diarias." />
  </head>
  <body class="bg-slate-50 min-h-screen font-sans text-gray-900 bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-indigo-300 via-fuchsia-100 to-cyan-200 selection:bg-purple-300">
    <Header />
    
    <section class="max-w-5xl mx-auto text-center px-4 pt-28 pb-10">
      <h1 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gray-900 via-blue-800 to-gray-900 mb-6 tracking-tight leading-tight pb-4">
        Descubre el Poder de la Inteligencia Artificial
      </h1>
      <p class="text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto">
        Explora la colección más completa de herramientas de Inteligencia Artificial. Aprende, crea, diviértete y simplifica tus tareas diarias con las tecnologías más innovadoras del momento, diseñadas para todo el mundo.
      </p>
    </section>

    <main class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 p-8 max-w-7xl mx-auto">
      {activeTools.map((tool, index) => (
        <>
          <ToolCard 
            tool_id={tool.tool_id}
            name={tool.name}
            short_description={tool.short_description}
            long_description={tool.long_description}
            category={tool.category}
            pricing_model={tool.pricing_model}
            website_url={tool.website_url}
            logo_url={tool.logo_url}
            is_active={tool.is_active}
            added_date={tool.added_date}
            last_verified_date={tool.last_verified_date}
          />
          {(index + 1) % 4 === 0 && <AdSenseCard />}
        </>
      ))}
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>
