---
import Header from '../../components/Header.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSenseCard from '../../components/AdSenseCard.astro';
import Footer from '../../components/Footer.astro';
import CookieBanner from '../../components/CookieBanner.astro';
import toolsData from '../../data/tools.json';
import '../../styles/global.css';

export function getStaticPaths() {
  return [
    { 
      params: { categoria: 'generacion-de-texto' }, 
      props: { name: 'Generación de Texto', description: 'Descubre las mejores herramientas de Inteligencia Artificial para redactar, resumir y generar textos de alta calidad.' } 
    },
    { 
      params: { categoria: 'imagen-y-diseno' }, 
      props: { name: 'Imagen y Diseño', description: 'Explora generadores de imágenes por IA, herramientas de edición fotorrealista y diseño gráfico avanzado.' } 
    },
    { 
      params: { categoria: 'audio-y-video' }, 
      props: { name: 'Audio y Vídeo', description: 'Encuentra soluciones de IA para síntesis de voz, clonación, creación de avatares y edición de vídeo profesional.' } 
    },
    { 
      params: { categoria: 'desarrollo-y-codigo' }, 
      props: { name: 'Desarrollo y Código', description: 'Potencia tu programación con asistentes de código, IDEs impulsados por IA y herramientas de refactorización.' } 
    },
    { 
      params: { categoria: 'productividad' }, 
      props: { name: 'Productividad', description: 'Optimiza tu tiempo con asistentes virtuales, transcriptores de reuniones y organizadores inteligentes.' } 
    }
  ];
}

const { categoria } = Astro.params;
const { name, description } = Astro.props;

const filteredTools = toolsData.filter(
  (tool) => tool.is_active === true && tool.category === name
);
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{name} - Directorio IA</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-50 min-h-screen font-sans text-gray-900 bg-[radial-gradient(circle_at_top_left,_var(--tw-gradient-stops))] from-indigo-300 via-fuchsia-100 to-cyan-200 selection:bg-purple-300">
    <Header />
    
    <section class="max-w-5xl mx-auto text-center px-4 pt-28 pb-10">
      <h1 class="text-5xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-gray-900 via-blue-800 to-gray-900 mb-6 tracking-tight leading-tight pb-4">
        {name}
      </h1>
      <p class="text-xl text-gray-600 leading-relaxed max-w-3xl mx-auto">
        {description} Explora nuestra selección y encuentra la herramienta perfecta para potenciar tu creatividad, aprender y facilitar tu día a día.
      </p>
    </section>

    <main class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 p-8 max-w-7xl mx-auto">
      {filteredTools.map((tool, index) => (
        <>
          <ToolCard 
            tool_id={tool.tool_id}
            name={tool.name}
            short_description={tool.short_description}
            long_description={tool.long_description}
            category={tool.category}
            pricing_model={tool.pricing_model}
            website_url={tool.website_url}
            logo_url={tool.logo_url}
            is_active={tool.is_active}
            added_date={tool.added_date}
            last_verified_date={tool.last_verified_date}
          />
          {(index + 1) % 4 === 0 && <AdSenseCard />}
        </>
      ))}
      
      {filteredTools.length === 0 && (
        <div class="col-span-full text-center py-12">
          <p class="text-gray-500 text-lg">Próximamente añadiremos más herramientas a esta categoría.</p>
        </div>
      )}
    </main>

    <Footer />
    <CookieBanner />
  </body>
</html>
