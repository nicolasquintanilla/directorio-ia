---
---

<div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[100] bg-slate-900/95 backdrop-blur-md text-white p-6 shadow-2xl transform translate-y-full transition-transform duration-500 hidden border-t border-slate-800">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-sm text-slate-300 md:pr-8 text-center md:text-left leading-relaxed">
      Utilizamos cookies propias y de terceros para mejorar nuestros servicios y mostrarle publicidad relacionada con sus preferencias mediante el análisis de sus hábitos de navegación. Puede consultar nuestra 
      <a href="/cookies" class="text-blue-400 hover:text-blue-300 underline underline-offset-2 transition-colors">Política de Cookies</a> para más información.
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3 flex-shrink-0 w-full md:w-auto">
      <button id="cookie-btn-essential" class="w-full sm:w-auto px-5 py-2.5 text-sm font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-xl transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-slate-500">
        Solo esenciales
      </button>
      <button id="cookie-btn-accept" class="w-full sm:w-auto px-5 py-2.5 text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 rounded-xl shadow-[0_0_15px_rgba(37,99,235,0.3)] transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
        Aceptar todas
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    const btnEssential = document.getElementById('cookie-btn-essential');
    const btnAccept = document.getElementById('cookie-btn-accept');

    const hideBanner = (preference: string) => {
      localStorage.setItem('cookies-preference', preference);
      
      // Animación de salida: bajamos el banner
      banner.classList.add('translate-y-full');
      
      // Tras 500ms (lo que dura la transición CSS), ocultamos del DOM
      setTimeout(() => {
        banner.classList.add('hidden');
      }, 500);
    };

    if (!localStorage.getItem('cookies-preference')) {
      // Si no hay preferencia, preparamos el banner para mostrarse
      banner.classList.remove('hidden');
      
      // Forzamos un reflow del navegador para que CSS registre que ya no está 'hidden' 
      // antes de quitarle el translate, logrando así que la animación fluya correctamente
      void banner.offsetWidth;
      
      // Animación de entrada: subimos el banner
      banner.classList.remove('translate-y-full');
    }

    if (btnEssential) {
      btnEssential.addEventListener('click', () => hideBanner('essential'));
    }
    
    if (btnAccept) {
      btnAccept.addEventListener('click', () => hideBanner('all'));
    }
  });
</script>
